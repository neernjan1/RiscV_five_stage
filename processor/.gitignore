# =========================
# BUILD / SIMULATION OUTPUT
# =========================

# Verilator
verilator/obj_dir/

# Waveforms
*.vcd
*.fst

# Logs (regenerated by run_assembly.sh / run.sh)
rtl.log
spike_commit.log
*.log

# Compiled ELFs / binaries (regenerated by run_assembly.sh / run.sh)
gcc_files/tst.elf
gcc_files/tst_spike.elf
gcc_files/*.o
gcc_files/disasm.txt
gcc_files/spike_disasm.txt
test.bin

# Generated memory images (regenerated by run_assembly.sh / run.sh)
# memory_files/*.mem
# memory_files/*.hex
# verilator/imem.mem
# verilator/dmem.mem

# Icarus / VVP (standalone testbenches, e.g. tb_csr_hazard.v)
*.vvp

# =========================
# OS / EDITOR
# =========================
.DS_Store
*.swp

# =========================
# TOOLING
# =========================

# Bender's internal git object cache (regenerable via `bender update`;
# only .bender/git/checkouts is actually referenced by the build)
rtl/apb_uart/.bender/git/db/

# Claude Code local settings
.claude/
