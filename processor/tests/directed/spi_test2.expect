# See spi_test2.s's header comment for what each register means.
# CLKDIV/SPICMD/SPIADR/SPIDUM/INTCFG read back verbatim. SPILEN (x6)
# packs cmd_len/addr_len/data_len subfields with reserved padding bits
# in between (see spi_master_apb_if.sv's REG_SPILEN read mux), so the
# written 0x81808008 reads back with its two padding bits masked to 0.
x3=4
x4=0xa5000000
x5=0x12345678
x6=0x81800008
x7=8
x8=3
